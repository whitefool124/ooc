{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://occ.local/schema/occ-battle-map-v1.schema.json",
  "title": "OCC Battle Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "objectiveSummary", "objectiveType", "tier", "width", "height", "complexMechanics", "floorTheme", "isElite", "isBoss", "prerequisites", "heroSpawn", "enemies", "terrain", "blockedPositions", "changeAnnotations", "spaceContract"],
  "properties": {
    "schemaVersion": { "const": "occ-battle-map-v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9_$-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "objectiveSummary": { "type": "string" },
    "objectiveType": { "enum": ["Elimination", "Destruction"] },
    "tier": { "type": "integer", "minimum": 1 },
    "width": { "type": "integer", "minimum": 4, "maximum": 12 },
    "height": { "type": "integer", "minimum": 4, "maximum": 10 },
    "complexMechanics": { "type": "boolean", "description": "40 格及以上正式地图必须为 true；25–36 格为默认范围。" },
    "floorTheme": { "enum": ["StoneRoad", "Courtyard", "Ruins", "AetherMarked"] },
    "isElite": { "type": "boolean" },
    "isBoss": { "type": "boolean" },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "heroSpawn": { "$ref": "#/$defs/nullablePosition" },
    "enemies": { "type": "array", "items": { "$ref": "#/$defs/enemy" } },
    "terrain": { "type": "array", "items": { "$ref": "#/$defs/terrain" } },
    "blockedPositions": { "type": "array", "items": { "$ref": "#/$defs/position" } },
    "changeAnnotations": { "type": "array", "items": { "$ref": "#/$defs/changeAnnotation" } },
    "spaceContract": { "$ref": "#/$defs/spaceContract" },
    "notes": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
    },
    "nullablePosition": { "anyOf": [{ "$ref": "#/$defs/position" }, { "type": "null" }] },
    "enemy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetypeId", "x", "y"],
      "properties": {
        "archetypeId": { "type": "string", "minLength": 1 },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "kind", "mechanismKind"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["LightCover", "HeavyCover", "PermanentWall", "AetherObjective", "Water", "LampVine", "AetherCrystal", "PressureCrystal", "LootChest", "TowerMechanism", "OverloadDevice", "WardGenerator", "LoosePaper", "Trace", "BindingMark", "Fireground", "Smoke"] },
        "mechanismKind": { "type": "integer", "minimum": 0, "maximum": 3 },
        "duration": { "type": "integer", "minimum": 0 },
        "durability": { "type": "integer", "minimum": 0 }
      }
    },
    "changeAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "timing", "trigger", "result", "duration", "source", "positions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "type": { "enum": ["phase", "temporary"] },
        "label": { "type": "string", "minLength": 1 },
        "timing": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "positions": { "type": "array", "items": { "$ref": "#/$defs/position" }, "uniqueItems": true }
      }
    },
    "spaceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grammar", "publicRisk", "counterplayWindow"],
      "properties": {
        "grammar": { "type": "string" },
        "publicRisk": { "type": "string" },
        "counterplayWindow": { "type": "string" }
      }
    }
  }
}
