[{"sheet_name": "07_技能配置", "range": "C3", "cells": [[{"value": "对十字范围内单位各造成16点火焰伤害。摧毁轻掩体，并在空格生成持续3个自身回合的火场。重掩体阻挡投放。"}]]}, {"sheet_name": "07_技能配置", "range": "C53", "cells": [[{"value": "对前方2格地块造成8点伤害；命中的物件获得裂痕。"}]]}, {"sheet_name": "07_技能配置", "range": "C55", "cells": [[{"value": "对扇形内地块各造成12点武器伤害和4点火焰伤害。破障。"}]]}, {"sheet_name": "07_技能配置", "range": "C56", "cells": [[{"value": "对相邻格的地块各造成16点武器伤害和8点火焰伤害。破障。"}]]}, {"sheet_name": "07_技能配置", "range": "C67", "cells": [[{"value": "对相邻敌人造成20点伤害；本回合有突进轨迹时，改为对轨迹旁敌人各造成20点伤害。"}]]}, {"sheet_name": "07_技能配置", "range": "K67", "cells": [[{"value": "相邻敌单体；本回合有突进轨迹时改为路径旁敌人"}]]}, {"sheet_name": "07_技能配置", "range": "C71", "cells": [[{"value": "沿本回合突进轨迹退回最多2格。"}]]}, {"sheet_name": "07_技能配置", "range": "K71", "cells": [[{"value": "本回合突进轨迹上的合法空格；最多2格"}]]}, {"sheet_name": "07_技能配置", "range": "L71", "cells": [[{"value": "沿本回合突进轨迹退回最多2格"}]]}, {"sheet_name": "07_技能配置", "range": "C79", "cells": [[{"value": "对直线内单位各造成8点火焰伤害。破障。"}]]}, {"sheet_name": "07_技能配置", "range": "C80", "cells": [[{"value": "对扇形内地块各造成8点火焰伤害。破障。"}]]}, {"sheet_name": "07_技能配置", "range": "C88", "cells": [[{"value": "以4格内一格火场为中心，对周围单位各造成12点火焰伤害，并移除该火场。"}]]}, {"sheet_name": "07_技能配置", "range": "C91", "cells": [[{"value": "将扇形内燃烧的单位各推开2格。"}]]}, {"sheet_name": "07_技能配置", "range": "C93", "cells": [[{"value": "对范围内单位各造成20点火焰伤害，并在空格生成持续3回合的火场。"}]]}, {"sheet_name": "07_技能配置", "range": "C94", "cells": [[{"value": "对直线4格内首个单位及沿线物件各造成6点伤害；命中的物件获得裂痕。"}]]}, {"sheet_name": "07_技能配置", "range": "C95", "cells": [[{"value": "对前方锥形范围内单位各造成8点伤害。破障。"}]]}, {"sheet_name": "07_技能配置", "range": "C96", "cells": [[{"value": "选择一个破口，将相邻敌我单位各推开1格。"}]]}, {"sheet_name": "07_技能配置", "range": "K96", "cells": [[{"value": "破口；相邻单位"}]]}, {"sheet_name": "07_技能配置", "range": "C99", "cells": [[{"value": "对4格内目标格及相邻地块造成12点伤害。破障。"}]]}, {"sheet_name": "07_技能配置", "range": "C102", "cells": [[{"value": "对扇形内的地块造成4点伤害；命中的物件获得裂痕。"}]]}, {"sheet_name": "07_技能配置", "range": "C103", "cells": [[{"value": "对4格内一格地块造成8点伤害。破障。"}]]}, {"