+                rect.SetSizeWithCurrentAnchors(RectTransform.Axis.Vertical,sprite.rect.height/(32*Mathf.Abs(scale.y)));
+                rect.position+=centre-rect.TransformPoint(rect.rect.center);
+                image.preserveAspect=true;
